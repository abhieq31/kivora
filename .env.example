# Public URL of the site (used for sitemap, canonical URLs and OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (Neon, Supabase, RDS…). Leave empty locally to use an
# embedded PGlite database in ./.data that is created and seeded automatically.
DATABASE_URL=

# Set to 1 to auto-load demo data into an empty DATABASE_URL on first request.
# Prefer `npm run db:demo` instead.
AUTO_SEED=

# Passwords for the seeded admin and demo accounts (admin@nakshly.dev, demo@nakshly.dev, agent@nakshly.dev).
# Defaults are for local development only. Always set these before seeding a public deployment.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Photo uploads: with a Vercel Blob token, photos go to Blob storage; otherwise to UPLOAD_DIR on disk.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# Map tiles. Defaults to the public OpenStreetMap tile server, which is fine for development
# but not for production traffic (see https://operations.osmfoundation.org/policies/tiles/).
# Use a provider such as MapTiler, Stadia or Carto with an API key, e.g.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
